<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>in.railops</groupId>
  <artifactId>railops-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>RailOps</name>

  <modules>
    <module>railops-common</module>
    <module>railops-test-support</module>
    <module>reservation-service</module>
    <module>identity-service</module>
    <module>payment-service</module>
    <module>notification-service</module>
    <module>api-gateway</module>
    <module>tools/local-kafka</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <!-- Security pins over versions that come in transitively (CI's Trivy scan fails on the older ones). -->
    <bouncycastle.version>1.87</bouncycastle.version>      <!-- gateway got 1.80.2 transitively: CVE-2026-8763, -13506 -->
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>in.railops</groupId>
        <artifactId>railops-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.railops</groupId>
        <artifactId>railops-test-support</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <!-- 2.x = Jackson 2 (Boot 3.5). 3.x moved to Jackson 3: don't "upgrade" without moving Boot to 4. -->
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>2.0.4</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot4</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <!-- Comes in through kafka-clients (3.9.2 brings 1.1.10.5). Versions through 1.1.10.8 have buffer overflows
             on malformed or incompressible input (CVE-2026-93451, CVE-2026-93452); CI's Trivy scan fails on them.
             Drop this pin once kafka-clients itself depends on a fixed release. -->
        <groupId>org.xerial.snappy</groupId>
        <artifactId>snappy-java</artifactId>
        <version>1.1.10.12</version>
      </dependency>
      <dependency>
        <!-- Also from kafka-clients (4.2.2 brings 1.11.2): insecure temp-file handling (CVE-2026-106451). -->
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.11.4</version>
      </dependency>
      <dependency>
        <!-- identity-service uses it directly (Argon2); the gateway pulls it in transitively. One version for both. -->
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- Always rebuild the jar. Otherwise a module whose own classes didn't change keeps its previously
               REPACKAGED jar, and spring-boot:repackage reuses its nested libs: a change in railops-common alone
               would ship inside a service with the OLD common (found in Phase 12). -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <configuration>
            <forceCreation>true</forceCreation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:all,-processing,-serial</arg>
            </compilerArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Test tiers: *Test = unit (surefire, `mvn test`, no infrastructure);
           *IT = integration (failsafe, `mvn verify`, needs PostgreSQL via RAILOPS_IT_PG or Docker). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables><user.timezone>UTC</user.timezone></systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables><user.timezone>UTC</user.timezone></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
