# Copy to deploy/render/render.env and fill in. render.env is gitignored: it never leaves your computer.
# Every value here comes from a dashboard; the README says which one.

# --- Neon (Dashboard > your project > Connect > DIRECT connection, NOT "pooled") ---
NEON_HOST=ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech
NEON_DB=neondb

# --- Confluent Cloud (Cluster > Cluster settings > Bootstrap server; API keys > Create key) ---
KAFKA_BOOTSTRAP=pkc-xxxxx.ap-south-1.aws.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=
# Partitions per topic (max). 2 keeps all 12 topics inside Confluent Basic's free eCKU (30 partitions).
KAFKA_MAX_PARTITIONS=2

# --- Redis (README Step 7) ---
# Option A, Render Key Value: Connect > Internal, the host part of redis://HOST:6379. Leave the password empty.
# Option B, Redis Cloud free (when the workspace's one free Key Value is already used):
#   Database > Configuration > Public endpoint "HOST:PORT", and Security > Default user password.
REDIS_HOST=red-xxxxxxxxxxxxxxxxxxxx
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
# true only if the provider requires TLS (Upstash: true; Redis Cloud free: false)
REDIS_SSL=false

# --- Your Render URLs. Fill these in after creating each service (Step 5 of the README). ---
# Demo mode (all Free): use each service's PUBLIC https://....onrender.com URL.
# Reliable mode (paid private services): use the INTERNAL address, e.g. http://railops-identity:8080
IDENTITY_URL=https://railops-identity.onrender.com
RESERVATION_URL=https://railops-reservation.onrender.com
PAYMENT_URL=https://railops-payment.onrender.com
NOTIFICATION_URL=https://railops-notification.onrender.com
# Free plan: the gateway wakes sleeping services (see README "Sleeping services"). false on always-on plans.
RAILOPS_WAKE=true
# The gateway and the web site are always public.
GATEWAY_URL=https://railops-gateway.onrender.com
WEB_URL=https://railops-web.onrender.com

# --- First admin account (log in with it, then enrol MFA). ---
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# --- RailLens (Phase 3B) ---------------------------------------------------
# Where RailOps reads train timetables from when staff import runs.
RAILLENS_API_URL=https://raillens-api.onrender.com/api/v1
# The RailLens website's address, allowed to call the RailOps API from the browser. Leave empty to block.
RAILLENS_WEB_ORIGIN=https://rail-lens-frontend.vercel.app

# --- Payments (Phase 6) -----------------------------------------------------
# sim = built-in simulated gateway (default). razorpay = Razorpay TEST MODE: get test keys at
# dashboard.razorpay.com (Test Mode switch on) -> Account & Settings -> API Keys. Live keys (rzp_live_) are refused:
# RailOps can't sell real train tickets. Webhook: Razorpay -> Webhooks -> URL https://<gateway>/webhooks/razorpay,
# events payment_link.paid, payment_link.expired, payment_link.cancelled, refund.processed; same secret as below.
PAYMENT_GATEWAY=sim
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
