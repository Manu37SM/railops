{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.railops.in/events/PaymentFailed.v1.schema.json",
  "title": "PaymentFailed",
  "description": "Consumers: reservation.",
  "type": "object",
  "properties": {
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "pnr": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "paymentId",
    "pnr",
    "reason"
  ],
  "additionalProperties": false
}
